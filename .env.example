# RAG Pipeline Configuration Template
# ------------------------------------------------------------------------------
# QUICK SETUP:
#
# 1. For Docker Compose Deployment (Recommended):
#      cp .env.example .env.docker
#      (Replace <POSTGRES_PASSWORD> with your own secure password)
#
# 2. For Local Host Development (Native Python):
#      cp .env.example .env
#      (Update DATABASE_URL and OLLAMA_URL for localhost)

# Database Configuration
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
# IMPORTANT: Replace with your own secure password before launching
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>

# Database Connection URL (AsyncPG format)
# - For Docker Compose (using internal container service name 'postgres'):
DATABASE_URL=postgresql+asyncpg://raguser:<POSTGRES_PASSWORD>@postgres:5432/ragdb
# - For Local Host Development (using localhost):
# DATABASE_URL=postgresql+asyncpg://raguser:<POSTGRES_PASSWORD>@localhost:5432/ragdb

# LLM Model Configuration (Ollama)
# - For Docker Compose (bridges to Ollama running on host machine):
OLLAMA_URL=http://host.docker.internal:11434
# - For Local Host Development:
# OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

# Embedding Model Configuration (HuggingFace Sentence-Transformers)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768

# Neural Reranker Configuration (Cross-Encoder)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_BATCH_SIZE=32
RERANKER_MAX_LENGTH=512

# Ingestion & Seeding Configuration
# SEED_MAX_DOCS: 0 = ingest full 5,183 SciFact corpus; positive integer = partial seed (e.g. 500)
SEED_MAX_DOCS=0
DOCUMENT_BATCH_SIZE=100
EMBEDDING_BATCH_SIZE=64

# Chunker Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=150